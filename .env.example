# ─── Supabase ────────────────────────────────────────────────────────────────
# Copy to `.env.local` for local development, and add the same pair to your
# Vercel project under Settings → Environment Variables.
#
# Both values are safe to expose in the browser: the publishable (anon) key only
# grants what Row Level Security allows, and every table is restricted to
# `auth.uid() = user_id`. Never put the service_role key here — it bypasses RLS.
#
# Find both in Supabase → Project Settings → API.

NEXT_PUBLIC_SUPABASE_URL=https://your-project-ref.supabase.co
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=your-publishable-or-anon-key

# The VITE_* spelling is also accepted (mapped through next.config.ts).
# Set one pair or the other — NEXT_PUBLIC_* wins if both are present.
# VITE_SUPABASE_URL=https://your-project-ref.supabase.co
# VITE_SUPABASE_PUBLISHABLE_KEY=your-publishable-or-anon-key
